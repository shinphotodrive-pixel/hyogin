            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-brand-500', 'text-brand-600');
                btn.classList.add('border-transparent', 'text-slate-500');
            });
            // 선택된 탭 버튼 스타일 적용
            const selectedBtn = document.getElementById(`tab-${tabId}`);
            selectedBtn.classList.remove('border-transparent', 'text-slate-500');
            selectedBtn.classList.add('border-brand-500', 'text-brand-600');

            // 모든 컨텐츠 숨기기
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });
            // 선택된 컨텐츠 보이기
            document.getElementById(`content-${tabId}`).classList.add('active');
        }

